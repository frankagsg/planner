# =============================================================================
# Wall Planner — Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env. Secrets stay OUT of the frontend bundle.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port the Express backend listens on.
PORT=4000

# Bind address. 0.0.0.0 lets other devices on your LAN reach it (needed if you
# ever open the UI from a phone on the same Wi-Fi). Use 127.0.0.1 to restrict
# to the Pi itself only.
HOST=0.0.0.0

# Node environment: development | production
NODE_ENV=production

# Absolute or relative path to the SQLite database file.
DATABASE_PATH=./database/planner.db

# Where automatic + manual backups are written.
BACKUP_DIR=./backups

# Number of automatic backups to retain (older ones are pruned).
BACKUP_RETENTION=7

# Automatic backup interval in hours (0 disables the scheduler).
BACKUP_INTERVAL_HOURS=24

# Comma-separated list of origins allowed by CORS. For a local kiosk the
# frontend is served same-origin in production so this can stay tight.
# In dev, Vite runs on 5173.
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Admin token protecting system endpoints (reboot/shutdown/restore).
# Generate a long random string. If empty, system endpoints are LAN-only and
# additionally require the request to originate from a private IP.
ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# Weather (provider: openmeteo | openweathermap)
# -----------------------------------------------------------------------------
# open-meteo requires NO API key and is the default (free, no signup).
# openweathermap requires a key from https://openweathermap.org/api
WEATHER_PROVIDER=openmeteo

# Only needed if WEATHER_PROVIDER=openweathermap. Leave blank for open-meteo.
WEATHER_API_KEY=

# Default location (used until the user sets one in Settings).
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
WEATHER_LABEL=New York, NY

# Units: metric | imperial
WEATHER_UNITS=imperial

# -----------------------------------------------------------------------------
# Google Calendar OAuth 2.0
# -----------------------------------------------------------------------------
# Create an OAuth "Web application" client in Google Cloud Console.
# See docs/google-calendar-setup.md for the full walkthrough.
# These are NOT secrets that appear in the frontend — they are used only by the
# backend to run the OAuth flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The redirect URI must EXACTLY match one registered in Google Cloud Console.
# For a kiosk, the loopback flow is easiest. Example values:
#   http://localhost:4000/api/google/callback
#   http://jessie-planner.local:4000/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback

# Where the encrypted OAuth token is stored on disk (chmod 600).
GOOGLE_TOKEN_PATH=./config/google-token.json

# -----------------------------------------------------------------------------
# Kiosk / Display (consumed by scripts, documented for the Pi)
# -----------------------------------------------------------------------------
# The URL Chromium opens in kiosk mode.
KIOSK_URL=http://localhost:4000

# Screen wake/sleep schedule (24h HH:MM). Managed in-app too; these are the
# defaults seeded on first run.
SCREEN_WAKE=07:00
SCREEN_SLEEP=23:30
