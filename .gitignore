database/*.db
database/*.db-shm
database/*.db-wal
database/*.sqlite

# Backups (generated)
backups/*.zip
backups/*.tar.gz

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# User photos (personal)
client/public/photos/*
!client/public/photos/.gitkeep
